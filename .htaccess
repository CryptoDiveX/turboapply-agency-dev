<IfModule mod_rewrite.c>
  RewriteEngine On

  # Lead/API traffic is handled by the approved Cloudflare Worker and the
  # TurboApply-owned backend. Direct-origin legacy runtime paths fail closed.
  RewriteRule ^(?:submit-lead\.php|leads-export\.php|api/health(?:\.php)?|api/contact(?:/index\.php)?|private/turboapply-(?:form-security|phone-metadata)\.php)(?:/.*)?$ - [R=404,L,NC]
  RewriteRule ^mcp/?$ /mcp.php [L]

  # Rescue stale mobile pages that still submit the old no-action form as GET /?name=...
  # Keep the query string so the Calendly booking route can still receive submitted values.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{QUERY_STRING} (^|&)name=[^&]+ [NC]
  RewriteCond %{QUERY_STRING} (^|&)contact=[^&]+ [NC]
  RewriteCond %{QUERY_STRING} (^|&)challenge=[^&]+ [NC]
  RewriteRule ^$ /book-meeting/ [R=303,L]
</IfModule>

<FilesMatch "^(?:\.lead.*|leads\.(?:csv|jsonl))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|script\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
